@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Métricas - ProjectPlanning</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f7f8fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .metrics-container {
            max-width: 1400px;
            margin: 20px auto;
            padding: 0 20px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s;
            height: 100%;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 10px 0;
        }

        .stat-label {
            color: #6c757d;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .project-item {
            background: white;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .project-name {
            font-weight: 600;
            color: #333;
        }

        .project-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .status-active {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-completed {
            background: #d4edda;
            color: #155724;
        }

        .status-future {
            background: #fff3cd;
            color: #856404;
        }

        .progress-bar-custom {
            height: 8px;
            border-radius: 10px;
        }

        .loading {
            text-align: center;
            padding: 60px;
            font-size: 1.2rem;
            color: #6c757d;
        }

        .no-data {
            text-align: center;
            padding: 60px;
            color: #6c757d;
        }

        .resource-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            margin: 5px;
            font-size: 0.9rem;
        }

        .badge-pending {
            background: #ffc107;
            color: #000;
        }

        .badge-offered {
            background: #17a2b8;
            color: #fff;
        }

        .badge-accepted {
            background: #28a745;
            color: #fff;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-light bg-light d-flex justify-content-between px-4 py-3">
        <span class="navbar-brand mb-0 h5">📊 Métricas de Proyectos</span>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" onclick="goBack()">← Volver</button>
            <button class="btn btn-outline-danger btn-sm" onclick="logout()">Cerrar sesión</button>
        </div>
    </nav>

    <div class="metrics-container">
        <!-- Selector de email -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="stat-card">
                    <h5 class="mb-3">👤 Seleccionar ONG</h5>
                    <p class="text-muted mb-3">
                        Ingresa el Email del <strong>Responsable del proyecto</strong> para ver las métricas de los proyectos que ha publicado.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Email del <strong>Responsable del proyecto</strong></label>
                            <input type="text" class="form-control" id="emailInput" placeholder="Ejemplo: aritzblesa@gmail.com" required>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-primary w-100" onclick="loadMetricsForEmail()">
                                📊 Ver Métricas
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="loading" class="loading" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando métricas...</p>
        </div>

        <div id="content" style="display: none;">
            <!-- Tarjetas de resumen -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">📢</div>
                        <div class="stat-label">Total Proyectos</div>
                        <div class="stat-number text-primary" id="totalProjects">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">⏰</div>
                        <div class="stat-label">Finalizados a Tiempo</div>
                        <div class="stat-number text-success" id="projectsOnTime">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">⏱️</div>
                        <div class="stat-label">Finalizados Tarde</div>
                        <div class="stat-number text-danger" id="projectsLate">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">📊</div>
                        <div class="stat-label">Tasa de Puntualidad</div>
                        <div class="stat-number text-info" id="onTimeRate">0%</div>
                    </div>
                </div>
            </div>

            <!-- Buscador por rango de fechas -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="stat-card">
                        <h5 class="mb-3">🔍 Buscar Proyectos por Fecha de Finalización Aproximada</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Fecha Inicio</label>
                                <input type="date" class="form-control" id="searchStartDate">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha Fin</label>
                                <input type="date" class="form-control" id="searchEndDate">
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button class="btn btn-primary w-100" onclick="searchProjectsByDate()">
                                    Buscar Proyectos
                                </button>
                            </div>
                        </div>
                        <div id="dateSearchResults" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="noData" class="no-data" style="display: none;">
            <h3>📭 No hay datos disponibles</h3>
            <p>Aún no has publicado ningún proyecto. ¡Comienza creando tu primer proyecto!</p>
            <button class="btn btn-primary mt-3" onclick="window.location.href='/Project/Create'">
                Crear Proyecto
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentEmail = null;

        // Función para cargar métricas con el email especificado
        async function loadMetricsForEmail() {
            const emailInput = document.getElementById("emailInput");
            const email = emailInput.value.trim();

            if (!email) {
                alert("⚠️ Por favor ingresa un identificador");
                return;
            }

            currentEmail = email;
            await loadMetrics(email);
        }

        async function loadMetrics(email) {
            try {
                console.log("Cargando métricas para:", email);

                // Mostrar loading
                document.getElementById("loading").style.display = "block";
                document.getElementById("content").style.display = "none";
                document.getElementById("noData").style.display = "none";

                const response = await fetch(`/api/metrics?email=${encodeURIComponent(email)}`);
                
                if (!response.ok) {
                    throw new Error(`Error: ${response.status}`);
                }

                const metrics = await response.json();
                console.log("Métricas recibidas:", metrics);

                // Ocultar loading y mostrar contenido
                document.getElementById("loading").style.display = "none";

                if (metrics.totalProjectsPublished === 0) {
                    document.getElementById("noData").style.display = "block";
                    return;
                }

                document.getElementById("content").style.display = "block";

                // Actualizar tarjetas de resumen
                document.getElementById("totalProjects").textContent = metrics.totalProjectsPublished;
                document.getElementById("projectsOnTime").textContent = metrics.projectsFinishedOnTime;
                document.getElementById("projectsLate").textContent = metrics.projectsFinishedLate;
                document.getElementById("onTimeRate").textContent = metrics.onTimeCompletionRate + "%";

            } catch (error) {
                console.error("Error al cargar métricas:", error);
                document.getElementById("loading").innerHTML = `
                    <div class="alert alert-danger">
                        <h5>Error al cargar métricas</h5>
                        <p>${error.message}</p>
                    </div>
                `;
            }
        }

        async function searchProjectsByDate() {
            if (!currentEmail) {
                alert("⚠️ Primero debes cargar las métricas de una ONG");
                return;
            }

            const startDate = document.getElementById("searchStartDate").value;
            const endDate = document.getElementById("searchEndDate").value;
            const resultsDiv = document.getElementById("dateSearchResults");

            if (!startDate || !endDate) {
                resultsDiv.innerHTML = '<div class="alert alert-warning mt-3">Por favor ingresa ambas fechas</div>';
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                resultsDiv.innerHTML = '<div class="alert alert-danger mt-3">La fecha de inicio debe ser anterior a la fecha fin</div>';
                return;
            }

            try {
                resultsDiv.innerHTML = '<div class="text-center mt-3"><div class="spinner-border text-primary" role="status"></div></div>';

                const response = await fetch(
                    `/api/metrics/projects-by-date?email=${encodeURIComponent(currentEmail)}&startDate=${startDate}&endDate=${endDate}`
                );

                if (!response.ok) throw new Error(`Error: ${response.status}`);

                const data = await response.json();
                
                if (data.count === 0) {
                    resultsDiv.innerHTML = `
                        <div class="alert alert-info mt-3">
                            No se encontraron proyectos finalizados entre ${startDate} y ${endDate}
                        </div>
                    `;
                    return;
                }

                resultsDiv.innerHTML = `
                    <div class="alert alert-success mt-3">
                        <strong>✅ ${data.count} proyecto(s) encontrado(s)</strong>
                    </div>
                    ${data.projects.map(project => `
                        <div class="project-item mt-2">
                            <div>
                                <div class="project-name">${project.name}</div>
                                <small class="text-muted">
                                    Finalizado: ${new Date(project.endDate).toLocaleDateString()}
                                </small>
                                <div class="mt-2">
                                    <span class="resource-badge badge-accepted">${project.acceptedResources} aceptados</span>
                                    <span class="resource-badge badge-pending">${project.pendingResources} pendientes</span>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                `;

            } catch (error) {
                console.error("Error al buscar proyectos:", error);
                resultsDiv.innerHTML = `
                    <div class="alert alert-danger mt-3">
                        Error al buscar proyectos: ${error.message}
                    </div>
                `;
            }
        }

        function goBack() {
            window.location.href = "/AuthView/OngMenu";
        }

        function logout() {
            localStorage.clear();
            window.location.href = "/AuthView/Login";
        }

        // Verificar sesión
        function checkSession() {
            const sessionId = localStorage.getItem("bonitaSessionId");
            const apiToken = localStorage.getItem("bonitaApiToken");
            
            if (!sessionId || !apiToken) {
                alert("Sesión no válida. Por favor inicia sesión.");
                window.location.href = "/AuthView/Login";
                return false;
            }
            
            return true;
        }

        // Verificar sesión al cargar
        checkSession();

        // Pre-llenar el email del usuario actual como sugerencia
        const currentUserEmail = localStorage.getItem("bonitaUsername");
        if (currentUserEmail) {
            document.getElementById("emailInput").value = currentUserEmail;
        }
    </script>
</body>
</html>
