@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menú Recursos - ProjectPlanning</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f7f8fa;
            height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 60px; 
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .card-menu {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 40px 30px;
            text-align: center;
            max-width: 450px;
            width: 90%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-menu:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
        }

        .menu-btn {
            width: 100%;
            margin: 12px 0;
            padding: 12px;
            font-size: 1.1rem;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        h2 {
            font-weight: 600;
            margin-bottom: 25px;
        }

        .icon {
            font-size: 1.3rem;
        }

        .footer-note {
            margin-top: 25px;
            color: #777;
            font-size: 0.9rem;
        }

        .user-info {
            background: #e8f5e9;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-light bg-light justify-content-between px-4 py-2">
        <span class="navbar-brand mb-0 h4">ProjectPlanning</span>
        <button id="logoutBtn" class="btn btn-outline-danger btn-sm">Cerrar sesión</button>
    </nav>

    <div class="card-menu mt-5">
        <div class="user-info">
            <strong>👤 Usuario:</strong> <span id="username"></span><br>
            <strong>🏢 Rol:</strong> ONG que ofrece recursos
        </div>

        <h2>Menú Recursos</h2>

        <button class="btn btn-success menu-btn" onclick="viewProjects()">
            <span class="icon">🔍</span> Ver proyectos disponibles
        </button>

        <button class="btn btn-outline-info menu-btn" onclick="showEmailModal()">
            <span class="icon">📝</span> Gestionar Observaciones
        </button>

        <p class="footer-note">Gestiona tus recursos desde este panel</p>
    </div>

    <!-- Modal para ingresar email -->
    <div class="modal fade" id="emailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ingresa tu email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Para gestionar observaciones, confirma el email con el que ofreciste recursos:</p>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="resourceEmail" placeholder="tu@email.com" required>
                        <small class="text-muted">Este email debe coincidir con el que usaste al ofrecer recursos en los proyectos.</small>
                    </div>
                    <div id="emailError" class="alert alert-danger" style="display: none;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="validateAndRedirect()">Continuar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function checkBonitaAccess() {
            const sessionId = localStorage.getItem("bonitaSessionId");
            const apiToken = localStorage.getItem("bonitaApiToken");
            const rolesJson = localStorage.getItem("bonitaRoles");
            const username = localStorage.getItem("bonitaUsername");

            console.log("Verificando acceso a ResourceMenu...");
            console.log("SessionId:", sessionId ? "✓" : "✗");
            console.log("ApiToken:", apiToken ? "✓" : "✗");

            // Si no hay sesión, redirigir a login
            if (!sessionId || !apiToken) {
                console.warn("No hay sesión, redirigiendo a login...");
                window.location.href = "/AuthView/Login";
                return;
            }

            // Mostrar nombre de usuario
            document.getElementById("username").textContent = username || "N/A";

            const roles = JSON.parse(rolesJson || "[]");
            console.log("Roles:", roles);

            // Verificar que tiene rol de offering resources
            const hasOfferingResources = roles.some(r => 
                String(r).toLowerCase().includes("offering_resources")
            );

            if (!hasOfferingResources) {
                console.warn("Usuario NO tiene rol de offering resources, redirigiendo a OngMenu...");
                window.location.href = "/AuthView/OngMenu";
            }
        }

        function viewProjects() {
            window.location.href = "/AuthView/ProjectList";
        }

        function showEmailModal() {
            const modal = new bootstrap.Modal(document.getElementById('emailModal'));
            // Pre-rellenar con el username de localStorage si existe
            const username = localStorage.getItem("bonitaUsername");
            if (username) {
                document.getElementById("resourceEmail").value = username;
            }
            modal.show();
        }

        async function validateAndRedirect() {
            const email = document.getElementById("resourceEmail").value.trim();
            const errorDiv = document.getElementById("emailError");
            
            if (!email) {
                errorDiv.textContent = "Por favor ingresa un email.";
                errorDiv.style.display = "block";
                return;
            }

            // Guardar el email en localStorage para que la vista de observaciones lo use
            localStorage.setItem("resourceOfferEmail", email);
            
            // Redirigir a la vista de observaciones
            window.location.href = "/Observation/Index";
        }

        function logout() {
            console.log("Cerrando sesión...");
            localStorage.clear();
            window.location.href = "/AuthView/Login";
        }

        // Event listeners
        document.getElementById("logoutBtn").addEventListener("click", logout);

        // Verificar acceso al cargar
        checkBonitaAccess();
    </script>
</body>
</html>
